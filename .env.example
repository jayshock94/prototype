# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real secrets.

# --- Required now (chunk 1) -------------------------------------------------

# Postgres connection string.
# Neon: Dashboard -> Connection Details -> use the POOLED connection string.
# Vercel Postgres: added automatically when you link the store to the project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The single admin password. There are no admin accounts -- this is it.
# Make it long and random. Generate one with:  openssl rand -base64 24
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# --- Optional ---------------------------------------------------------------

# Signs the admin session cookie so it cannot be forged.
# If you leave this unset it is derived from ADMIN_PASSWORD, which works fine.
# The only difference: with it unset, changing ADMIN_PASSWORD signs you out.
# Generate one with:  openssl rand -base64 32
# SESSION_SECRET=""

# --- Not needed yet, listed so you know what is coming -----------------------

# Chunk 2: file uploads. Vercel creates this when you add a Blob store.
# BLOB_READ_WRITE_TOKEN=""

# Chunk 4: the AI assistant. From console.anthropic.com.
# Server-side only -- this must never appear in browser code.
# ANTHROPIC_API_KEY=""
